# =============================================================================
# EXPENSE TRACKER CONFIGURATION
# =============================================================================
# Copy this file to .env and fill in your values.
# =============================================================================

# -----------------------------------------------------------------------------
# ANTHROPIC API (Required for AI categorization)
# -----------------------------------------------------------------------------
# Get your API key at: https://console.anthropic.com/settings/keys
#
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# -----------------------------------------------------------------------------
# GOOGLE SHEETS INTEGRATION (Optional)
# -----------------------------------------------------------------------------
# To sync expenses to Google Sheets:
# 1. Create a Google Cloud project
# 2. Enable Google Sheets API
# 3. Create a service account and download credentials.json
# 4. Share your spreadsheet with the service account email
#
GOOGLE_SHEET_ID=your-spreadsheet-id-or-url

# -----------------------------------------------------------------------------
# EMAIL NOTIFICATIONS (Optional)
# -----------------------------------------------------------------------------
# For spending threshold alerts via email.
# For Gmail, create an App Password at: https://myaccount.google.com/apppasswords
#
# NOTIFY_EMAIL=your-email@example.com
# SMTP_EMAIL=your-gmail@gmail.com
# SMTP_PASSWORD=your-app-password

# -----------------------------------------------------------------------------
# GMAIL SYNC (Optional)
# -----------------------------------------------------------------------------
# To sync transaction alerts from Bank of America emails:
# 1. Enable Gmail API in Google Cloud Console
# 2. Create OAuth 2.0 credentials (Desktop application)
# 3. Download and save as gmail_credentials.json
# 4. Run the email sync feature to authenticate
#
# The gmail_credentials.json file should be in the project root.
# A gmail_token.pickle file will be created after first authentication.
